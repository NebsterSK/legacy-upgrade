# ----------------------------------------------------------------------
# Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

# ----------------------------------------------------------------------
# Error documents
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# Cache-Control headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Fingerprinted build assets. Everything Next emits under _next/static/ is
    # content-hashed, and /icon.png, /opengraph-image.jpg and /twitter-image.jpg carry a
    # hash query string, so a year + immutable is safe for all of them.
    <FilesMatch "\.(css|js|woff2?|ttf|otf|eot|webp|png|jpe?g|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML — short TTL so content updates propagate quickly
    <FilesMatch "\.html?$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>

    # React Server Component payloads (index.txt, __next.*.txt). These mirror page
    # content, so they get the HTML TTL rather than the 1-day text/plain default —
    # otherwise a client-side navigation could serve day-old copy after a deploy.
    # MUST stay above the robots.txt rule below, which needs to win for that one file.
    <FilesMatch "^(index|__next\..*|_not-found.*)\.txt$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>

    # robots.txt and sitemap.xml — 1 day
    <FilesMatch "^(robots\.txt|sitemap\.xml)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# ExpiresByType fallback (if mod_headers is unavailable)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                              "access plus 1 month"

    ExpiresByType text/html                     "access plus 5 minutes"
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType text/javascript               "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType font/ttf                      "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"
    ExpiresByType text/plain                    "access plus 1 day"
    ExpiresByType application/xml               "access plus 1 day"
</IfModule>

# ----------------------------------------------------------------------
# Security headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
